generator client {
  provider = "prisma-client"
  output   = "../.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model UtilisateurRH {
  id           String   @id @default(uuid())
  email        String?  @unique
  mot_de_passe String
  nom_complet  String
  cree_le      DateTime @default(now())
  actif        Boolean  @default(true)
  username     String?  @unique
  conges_crees Conge[]

  @@index([actif])
  @@index([email, actif])
  @@index([username])
  @@map("utilisateurs_rh")
}

model CategoriePersonnel {
  id          Int          @id @default(autoincrement())
  nom         String       @unique
  professeurs Professeur[]

  @@map("categories_personnel")
}

model Specialite {
  id          Int          @id @default(autoincrement())
  nom         String       @unique
  professeurs Professeur[]

  @@map("specialites")
}

model Titre {
  id          Int          @id @default(autoincrement())
  nom         String       @unique
  professeurs Professeur[]

  @@map("titres")
}

model Service {
  id          Int          @id @default(autoincrement())
  nom         String       @unique
  professeurs Professeur[]

  @@map("services")
}

model Hopital {
  id          Int          @id @default(autoincrement())
  nom         String       @unique
  cree_le     DateTime     @default(now())
  professeurs Professeur[]

  @@map("hopitaux")
}

model Grade {
  id          Int          @id @default(autoincrement())
  nom         String       @unique
  professeurs Professeur[]

  @@map("grades")
}

model Professeur {
  id                     String              @id @default(uuid())
  nom                    String
  prenom                 String
  ppr                    String              @unique
  telephone              String?
  cree_le                DateTime            @default(now())
  categorie_personnel_id Int?
  specialite_id          Int?
  titre_id               Int?
  service_id             Int?
  Hopital_id             Int?
  grade_id               Int?
  conges                 Conge[]
  categorie_personnel    CategoriePersonnel? @relation(fields: [categorie_personnel_id], references: [id])
  service                Service?            @relation(fields: [service_id], references: [id])
  specialite             Specialite?         @relation(fields: [specialite_id], references: [id])
  titre                  Titre?              @relation(fields: [titre_id], references: [id])
  Hopital                Hopital?            @relation(fields: [Hopital_id], references: [id])
  grade                  Grade?              @relation(fields: [grade_id], references: [id])
  soldes                 SoldeConge[]

  @@index([nom])
  @@index([prenom])
  @@index([nom, prenom])
  @@map("professeurs")
}

model TypeConge {
  id                   Int          @id @default(autoincrement())
  nom                  String
  document_obligatoire Boolean      @default(false)
  conges               Conge[]
  soldes               SoldeConge[]

  @@map("types_conge")
}

model SoldeConge {
  id             String     @id @default(uuid())
  professeur_id  String
  annee          Int
  jours_total    Int
  jours_restants Int
  expire_le      DateTime
  type_conge_id  Int
  professeur     Professeur @relation(fields: [professeur_id], references: [id], onDelete: Cascade)
  type_conge     TypeConge  @relation(fields: [type_conge_id], references: [id])

  @@unique([professeur_id, annee, type_conge_id])
  @@index([professeur_id, annee])
  @@index([annee])
  @@index([expire_le])
  @@index([type_conge_id])
  @@map("soldes_conge")
}

model Conge {
  id             String        @id @default(uuid())
  professeur_id  String
  type_conge_id  Int
  date_debut     DateTime
  date_fin       DateTime
  duree_jours    Int
  reference_doc  String?
  cree_par_rh_id String
  cree_le        DateTime      @default(now())
  nom_interim    String?
  prenom_interim String?
  cree_par_rh    UtilisateurRH @relation(fields: [cree_par_rh_id], references: [id])
  professeur     Professeur    @relation(fields: [professeur_id], references: [id], onDelete: Cascade)
  type_conge     TypeConge     @relation(fields: [type_conge_id], references: [id])

  @@index([professeur_id])
  @@index([date_debut])
  @@index([date_fin])
  @@index([type_conge_id])
  @@index([date_debut, date_fin])
  @@map("conges")
}
