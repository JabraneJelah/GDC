// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================
// Module: Dossiers Explicatifs
// =========================

// Statut du dossier (cycle de vie workflow)
enum StatutDossierExplicatif {
  ENREGISTRE
  DOCUMENTS_INITIAUX_GENERES
  BROUILLON
  NOTIFIE
  EN_ATTENTE_REPONSE
  REPONSE_RECUE
  REPONSE_CONVAINCANTE
  REPONSE_NON_CONVAINCANTE
  PROCEDURE_SUIVANTE_GENEREE
  EN_EVALUATION
  CLOTURE
  A_ARCHIVER
  ARCHIVE
}

// Décision sur la réponse (termes métier imposés)
enum DecisionReponseExplicative {
  CONVAINCANTE
  NON_CONVAINCANTE
}

// Type de procedure suivante apres reponse non convaincante
enum TypeProcedureExplicative {
  AVERTISSEMENT
  RETENUE
}

// Origine du document joint au dossier
enum OrigineDocumentDossier {
  TELEVERSE
  GENERE
}

// Format source d'un template stocké
enum FormatTemplateDocument {
  DOCX
  PDF
}

enum TemplateUsage {
  LETTRE_EXPLICATIVE
  BORDEREAU_NOTIFICATION
  AVERTISSEMENT
  RETENUE
  PROCEDURE_DISCIPLINAIRE
}

// Utilisateurs RH - Personnel RH qui utilise l'application
model UtilisateurRH {
  id           String   @id @default(uuid())
  email        String?  @unique
  username     String?  @unique
  mot_de_passe String // Hash bcrypt
  nom_complet  String
  role         String   @default("UTILISATEUR_RH")
  actif        Boolean  @default(true)
  cree_le      DateTime @default(now())

  // Relations
  conges_crees                   Conge[]
  document_templates_crees       DocumentTemplate[]  @relation("DocumentTemplateCreeParRH")
  dossiers_explicatifs_crees     DossierExplicatif[] @relation("DossierCreeParRH")
  dossiers_explicatifs_decides   DossierExplicatif[] @relation("DossierDecisionParRH")
  dossiers_explicatifs_clotures  DossierExplicatif[] @relation("DossierClotureParRH")
  dossiers_explicatifs_archives  DossierExplicatif[] @relation("DossierArchiveParRH")
  dossiers_documents_crees       DossierDocument[]   @relation("DossierDocumentCreeParRH")
  dossiers_historiques_effectues DossierHistory[]    @relation("DossierHistoryEffectueParRH")

  @@index([actif])
  @@index([email, actif])
  @@index([username])
  @@map("utilisateurs_rh")
}

// Types de faute/infraction (référentiel)
model TypeFaute {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  nom         String
  description String?
  actif       Boolean  @default(true)
  cree_le     DateTime @default(now())

  // Relations
  templates DocumentTemplate[]
  dossiers  DossierExplicatif[]

  @@index([actif])
  @@map("types_faute")
}

// Templates de documents gérés dans l'application (DOCX/PDF)
model DocumentTemplate {
  id             String                 @id @default(uuid())
  identifiant    String
  nom            String
  code           String?
  description    String?
  format_source  FormatTemplateDocument
  usage          TemplateUsage?
  chemin_fichier String
  version        Int                    @default(1)
  actif          Boolean                @default(true)
  cree_le        DateTime               @default(now())

  // Relations
  type_faute_id Int
  type_faute    TypeFaute @relation(fields: [type_faute_id], references: [id], onDelete: Restrict)

  cree_par_rh_id String?
  cree_par_rh    UtilisateurRH? @relation("DocumentTemplateCreeParRH", fields: [cree_par_rh_id], references: [id], onDelete: SetNull)

  documents_dossier               DossierDocument[]
  dossiers_procedure_selectionnee DossierExplicatif[] @relation("DossierProcedureTemplate")

  @@index([actif])
  @@index([type_faute_id])
  @@map("documents_templates")
}

// Dossier de demande d'explication / lettre explicative (entité centrale)
model DossierExplicatif {
  id        String @id @default(uuid())
  reference String @unique

  nom_complet   String
  matricule     String
  profil        String
  service       String
  professeur_id String?

  date_faute DateTime
  details    String?

  donnees_supplementaires Json?

  statut                     StatutDossierExplicatif     @default(BROUILLON)
  decision_reponse           DecisionReponseExplicative?
  type_procedure_selectionne TypeProcedureExplicative?

  date_notification   DateTime?
  date_limite_reponse DateTime?
  date_reponse_recue  DateTime?
  en_retard           Boolean   @default(false)

  cree_le DateTime @default(now())

  // Relations
  type_faute_id Int
  type_faute    TypeFaute @relation(fields: [type_faute_id], references: [id], onDelete: Restrict)

  cree_par_rh_id String
  cree_par_rh    UtilisateurRH @relation("DossierCreeParRH", fields: [cree_par_rh_id], references: [id], onDelete: Restrict)

  decision_par_rh_id String?
  decision_par_rh    UtilisateurRH? @relation("DossierDecisionParRH", fields: [decision_par_rh_id], references: [id], onDelete: SetNull)

  cloture_par_rh_id String?
  cloture_par_rh    UtilisateurRH? @relation("DossierClotureParRH", fields: [cloture_par_rh_id], references: [id], onDelete: SetNull)

  date_archivage    DateTime?
  archive_par_rh_id String?
  archive_par_rh    UtilisateurRH? @relation("DossierArchiveParRH", fields: [archive_par_rh_id], references: [id], onDelete: SetNull)

  template_procedure_id String?
  template_procedure    DocumentTemplate? @relation("DossierProcedureTemplate", fields: [template_procedure_id], references: [id], onDelete: SetNull)

  professeur Professeur? @relation("DossierProfesseur", fields: [professeur_id], references: [id], onDelete: SetNull)

  documents  DossierDocument[]
  historique DossierHistory[]

  @@index([statut])
  @@index([matricule])
  @@index([professeur_id])
  @@index([type_faute_id])
  @@index([template_procedure_id])
  @@map("dossiers_explicatifs")
}

// Documents attachés/générés pour un dossier
model DossierDocument {
  id             String                 @id @default(uuid())
  identifiant    String                 @unique
  titre          String
  chemin_fichier String
  origine        OrigineDocumentDossier
  categorie      String?
  cree_le        DateTime               @default(now())

  // Relations
  dossier_id String
  dossier    DossierExplicatif @relation(fields: [dossier_id], references: [id], onDelete: Cascade)

  template_id String?
  template    DocumentTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)

  cree_par_rh_id String?
  cree_par_rh    UtilisateurRH? @relation("DossierDocumentCreeParRH", fields: [cree_par_rh_id], references: [id], onDelete: SetNull)

  @@index([dossier_id])
  @@index([template_id])
  @@index([origine])
  @@map("dossiers_documents")
}

// Historique/audit des actions importantes sur un dossier
model DossierHistory {
  id             String                   @id @default(uuid())
  dossier_id     String
  action         String
  description    String?
  ancien_statut  StatutDossierExplicatif?
  nouveau_statut StatutDossierExplicatif?
  cree_le        DateTime                 @default(now())

  // Relations
  dossier            DossierExplicatif @relation(fields: [dossier_id], references: [id], onDelete: Cascade)
  effectue_par_rh_id String
  effectue_par_rh    UtilisateurRH     @relation("DossierHistoryEffectueParRH", fields: [effectue_par_rh_id], references: [id], onDelete: Restrict)

  @@index([dossier_id])
  @@index([cree_le])
  @@map("dossiers_historique")
}

// Catégories de Personnel
model CategoriePersonnel {
  id  Int    @id @default(autoincrement())
  nom String @unique

  // Relations
  professeurs Professeur[]

  @@map("categories_personnel")
}

// Spécialités
model Specialite {
  id  Int    @id @default(autoincrement())
  nom String @unique

  // Relations
  professeurs Professeur[]

  @@map("specialites")
}

// Titres
model Titre {
  id  Int    @id @default(autoincrement())
  nom String @unique

  // Relations
  professeurs Professeur[]

  @@map("titres")
}

// Services
model Service {
  id  Int    @id @default(autoincrement())
  nom String @unique

  // Relations
  professeurs Professeur[]

  @@map("services")
}

// Hôpitaux
model Hopital {
  id      Int      @id @default(autoincrement())
  nom     String   @unique
  cree_le DateTime @default(now())

  // Relations
  professeurs Professeur[]

  @@map("hopitaux")
}

// Grades
model Grade {
  id  Int    @id @default(autoincrement())
  nom String @unique

  // Relations
  professeurs Professeur[]

  @@map("grades")
}

// Professeurs - Identités des professeurs
model Professeur {
  id                     String   @id @default(uuid())
  nom                    String
  prenom                 String
  ppr                    String?  @unique // Numéro PPR unique (optionnel si inconnu à l’import)
  cin                    String?
  adresse                String?
  sexe                   String?
  lieu_naissance         String?
  ville                  String?
  specialite_id          Int
  categorie_personnel_id Int
  titre_id               Int
  service_id             Int?
  hopital_id             Int?
  grade_id               Int?
  telephone              String?
  cree_le                DateTime @default(now())

  // Relations
  specialite           Specialite          @relation(fields: [specialite_id], references: [id])
  categorie_personnel  CategoriePersonnel  @relation(fields: [categorie_personnel_id], references: [id])
  titre                Titre               @relation(fields: [titre_id], references: [id])
  service              Service?            @relation(fields: [service_id], references: [id], onDelete: SetNull)
  hopital              Hopital?            @relation(fields: [hopital_id], references: [id], onDelete: SetNull)
  grade                Grade?              @relation(fields: [grade_id], references: [id], onDelete: SetNull)
  conges               Conge[]
  soldes               SoldeConge[]
  dossiers_explicatifs DossierExplicatif[] @relation("DossierProfesseur")

  @@map("professeurs")
}

// Types de Congé
model TypeConge {
  id                   Int     @id @default(autoincrement())
  nom                  String // Annuel, Maladie, Exceptionnel
  document_obligatoire Boolean @default(false)

  // Relations
  conges Conge[]
  soldes SoldeConge[]

  @@map("types_conge")
}

// Soldes de Congé - Gestion automatique des soldes annuels (par type de congé)
model SoldeConge {
  id             String   @id @default(uuid())
  professeur_id  String
  annee          Int // Année du solde
  type_conge_id  Int // Type : Annuel, Exceptionnel, etc.
  jours_total    Int      @default(22) // 22 jours par défaut
  jours_restants Int // Jours restants
  expire_le      DateTime // Exceptionnel: 31/12 année; Administratif/autre: 31/12 année+1 (voir lib/solde-expiration.js)

  // Relations
  professeur Professeur @relation(fields: [professeur_id], references: [id], onDelete: Cascade)
  type_conge TypeConge  @relation(fields: [type_conge_id], references: [id], onDelete: Restrict)

  @@unique([professeur_id, annee, type_conge_id])
  @@map("soldes_conge")
}

// Congés - Enregistrements des congés
model Conge {
  id             String   @id @default(uuid())
  professeur_id  String
  type_conge_id  Int
  date_debut     DateTime
  date_fin       DateTime
  duree_jours    Int
  hors_solde     Boolean  @default(false) // true = enregistré sans consommer de solde
  nom_interim    String? // Nom complet du remplaçant (affiché dans المعوض)
  reference_doc  String? // Référence du document papier
  decision_doc   String? // JSON: fileName, fileUrl, fileType (décision officielle)
  cree_par_rh_id String
  cree_le        DateTime @default(now())

  // Relations
  professeur  Professeur    @relation(fields: [professeur_id], references: [id], onDelete: Cascade)
  type_conge  TypeConge     @relation(fields: [type_conge_id], references: [id])
  cree_par_rh UtilisateurRH @relation(fields: [cree_par_rh_id], references: [id])

  @@map("conges")
}

// Jours Fériés - Référentiel des jours fériés (plage : un jour = date_debut = date_fin)
model JourFerie {
  id         Int      @id @default(autoincrement())
  date_debut DateTime
  date_fin   DateTime
  nom        String
  actif      Boolean  @default(true)

  @@index([date_debut])
  @@index([date_fin])
  @@index([actif])
  @@map("jours_feries")
}
